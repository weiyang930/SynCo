+_VLLM_NEGATABLE_BOOL_ARGS: set[str] | None = None
+
+
+def _vllm_negatable_bool_args() -> set[str]:
+    """Return the set of vLLM serve boolean args that support a ``--no-<name>`` form.
+
+    vLLM registers ``Optional[bool]`` engine args with ``argparse.BooleanOptionalAction``,
+    which generates both ``--<name>`` and ``--no-<name>``. For those, passing the config
+    value ``False`` must emit ``--no-<name>`` — simply skipping the flag (the old behavior)
+    leaves the option at vLLM's own default, which for e.g. ``enable_prefix_caching`` is
+    "auto-enable", so ``enable_prefix_caching=False`` was silently ignored and prefix
+    caching stayed ON. Pure ``store_true`` flags (e.g. ``disable-log-stats``) are NOT in
+    this set and keep the skip-on-False behavior (passing ``--no-`` to them would error).
+
+    Both underscore and hyphen spellings are included so callers using either key style
+    match. Result is cached; on any probe failure we return an empty set so the caller
+    falls back to the historical skip-on-False behavior rather than crashing rollout boot.
+    """
+    global _VLLM_NEGATABLE_BOOL_ARGS
+    if _VLLM_NEGATABLE_BOOL_ARGS is not None:
+        return _VLLM_NEGATABLE_BOOL_ARGS
+
+    import argparse
+
+    dests: set[str] = set()
+    try:
+        from vllm.engine.arg_utils import AsyncEngineArgs
+        from vllm.utils import FlexibleArgumentParser
+
+        parser = FlexibleArgumentParser()
+        parser = AsyncEngineArgs.add_cli_args(parser)
+        for action in parser._actions:
+            if isinstance(action, argparse.BooleanOptionalAction):
+                dest = action.dest
+                dests.add(dest)
+                dests.add(dest.replace("_", "-"))
+    except Exception as e:  # noqa: BLE001 — never let arg-probing break rollout launch
+        logger.warning(
+            "Could not probe vLLM parser for negatable bool args (%s); "
+            "boolean False values will be skipped (may leave --no- flags unset).",
+            e,
+        )
+
+    _VLLM_NEGATABLE_BOOL_ARGS = dests
+    return _VLLM_NEGATABLE_BOOL_ARGS
+
+
